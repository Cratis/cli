<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Environments.Specs</AssemblyName>
        <RootNamespace>Cratis.Environments</RootNamespace>
        <!-- Runs on every target framework the published library ships for. -->
        <TargetFramework></TargetFramework>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Environments/Cratis.Environments.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
        <PackageReference Include="xunit.v3.mtp-off" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NSubstitute" />
    </ItemGroup>
</Project>
