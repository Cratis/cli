<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>Cratis.Cli</AssemblyName>
        <RootNamespace>Cratis.Cli</RootNamespace>
        <PackageId>Cratis.Cli</PackageId>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>cratis</ToolCommandName>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers></RuntimeIdentifiers>

        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(SelfContained)' == 'true'">
        <DefineConstants>$(DefineConstants);CRATIS_NATIVE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Chronicle.Connections" />
        <PackageReference Include="Cratis.Chronicle.Contracts" />
        <PackageReference Include="Cratis.Fundamentals" />
        <PackageReference Include="Cratis.Prologue.Configuration" />
        <PackageReference Include="Cratis.Prologue.Contracts" />
        <PackageReference Include="Cratis.Prologue.Interpretation" />
        <PackageReference Include="Cratis.Prologue.Interpreter.Contracts" />
        <PackageReference Include="Cratis.Prologue.Screenplay" />
        <PackageReference Include="Cratis.Screenplay" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Spectre.Console" />
        <PackageReference Include="Spectre.Console.Cli" />
        <PackageReference Include="SharpConsoleUI" />
        <!-- Override SharpConsoleUI's transitive AngleSharp to a version without GHSA-pgww-w46g-26qg (NU1902). -->
        <PackageReference Include="AngleSharp" />
        <PackageReference Include="Grpc.Net.Client" />
        <!-- Reading a solution or project into a Roslyn compilation for 'cratis screenplay generate'. -->
        <PackageReference Include="Microsoft.Build.Locator" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
        <!-- Without the C# language services a loaded project cannot produce a compilation. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <!-- MSBuild itself must come from the installed SDK that MSBuildLocator registers, never from the output folder. -->
        <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>

    <!--
        Cratis.Arc.Screenplay is not published yet. Point CratisArcScreenplayProject at a local checkout of its
        Screenplay.csproj to build the CLI against it — for example:
            dotnet build -p:CratisArcScreenplayProject=/path/to/Arc/Source/DotNET/Screenplay/Screenplay.csproj
        Without it the CLI still builds, and 'cratis screenplay generate' reports CLI0005 instead of generating.
        Once the package ships this becomes an ordinary PackageReference and the condition goes away.
    -->
    <PropertyGroup Condition="'$(CratisArcScreenplayProject)' != '' And Exists('$(CratisArcScreenplayProject)')">
        <DefineConstants>$(DefineConstants);CRATIS_ARC_SCREENPLAY</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(CratisArcScreenplayProject)' != '' And Exists('$(CratisArcScreenplayProject)')">
        <ProjectReference Include="$(CratisArcScreenplayProject)" />
    </ItemGroup>

    <ItemGroup Condition="'$(CratisArcScreenplayProject)' == '' Or !Exists('$(CratisArcScreenplayProject)')">
        <Compile Remove="Commands/Screenplay/ArcScreenplayGeneration.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- Cratis -->
        <Using Include="Cratis.Chronicle.Contracts" />
        <Using Include="Cratis.Chronicle.Contracts.Primitives" />
        <Using Include="Cratis.Chronicle.Connections" />
        <Using Include="Cratis.Chronicle.Contracts.EventSequences" />
        <Using Include="Cratis.Chronicle.Contracts.Events" />
        <Using Include="Cratis.Chronicle.Contracts.Observation" />
        <Using Include="Cratis.Chronicle.Contracts.Projections" />
        <Using Include="Cratis.Chronicle.Contracts.ReadModels" />
        <Using Include="Cratis.Chronicle.Contracts.Recommendations" />
        <Using Include="Cratis.Chronicle.Contracts.Security" />
        <Using Include="Cratis.Json" />
        <!-- Registration -->
        <Using Include="Cratis.Cli.Registration" />
        <!-- Spectre -->
        <Using Include="Spectre.Console" />
        <Using Include="Spectre.Console.Cli" />
        <!-- System -->
        <Using Include="System.ComponentModel" />
        <Using Include="System.Text.Json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Cli.Generators/Cli.Generators.csproj"
            OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)/../../README.md" Pack="true" PackagePath="/" />
        <None Include="$(MSBuildThisFileDirectory)/../../logo.png" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.Cli.Specs" />
    </ItemGroup>
</Project>
