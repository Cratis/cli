<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Cli.Specs</AssemblyName>
        <RootNamespace>Cratis.Cli</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <!-- Embedded.Generation transitively brings Embedded; its unread domain CratisCliSpecs placeholder fails separate compilation on Specifications 5's experimental resource attribute under xUnit v3. -->
        <CratisEmbeddedScreenplayEnabled>false</CratisEmbeddedScreenplayEnabled>
        <!-- Source-generated libc interop for bounded file-admission fixtures. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS0436</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Cli/Cli.csproj" />
    </ItemGroup>

    <!-- Capture the source checkout and evaluated build context, not the test host's output location.
         The sentinel pack does not restore, so it must reuse this build's assets and package versions. -->
    <Target Name="CaptureSentinelPackageBuild" BeforeTargets="GetAssemblyAttributes">
        <ItemGroup>
            <AssemblyMetadata Include="CliPackage.ProjectPath" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../Cli/Cli.csproj'))" />
            <AssemblyMetadata Include="CliPackage.Property.Configuration" Value="$(Configuration)" />
            <AssemblyMetadata Include="CliPackage.Property.DirectoryPackagesPropsPath" Value="$([System.IO.Path]::GetFullPath('$(DirectoryPackagesPropsPath)', '$(MSBuildProjectDirectory)'))" Condition="'$(DirectoryPackagesPropsPath)' != ''" />
            <AssemblyMetadata Include="CliPackage.Property.ArtifactsPath" Value="$(ArtifactsPath)" Condition="'$(UseArtifactsOutput)' == 'true'" />
            <AssemblyMetadata Include="CliPackage.Property.UseArtifactsOutput" Value="$(UseArtifactsOutput)" />
            <AssemblyMetadata Include="CliPackage.Property.RuntimeIdentifier" Value="$(RuntimeIdentifier)" />
            <AssemblyMetadata Include="CliPackage.Property.Platform" Value="$(Platform)" />
            <AssemblyMetadata Include="CliPackage.Property.TreatWarningsAsErrors" Value="$(TreatWarningsAsErrors)" />
            <AssemblyMetadata Include="CliPackage.Property.MSBuildTreatWarningsAsErrors" Value="$(MSBuildTreatWarningsAsErrors)" />
            <AssemblyMetadata Include="CliPackage.Property.CodeAnalysisTreatWarningsAsErrors" Value="$(CodeAnalysisTreatWarningsAsErrors)" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <!-- The application shell fixture the integration scripts render and run: navigation regions across three modules, a toolbar slice button and sample data. -->
        <None Include="../../Integration/Cli/Shell/model/**" Link="Shell/model/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- The transitive Spectre.Console.Cli does not flow from the CLI project's output; command specs need its types. -->
        <PackageReference Include="Spectre.Console.Cli" />
        <PackageReference Include="Cratis.Screenplay.CanonicalCorpus" PrivateAssets="all" />
        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
        <PackageReference Include="xunit.v3.mtp-off" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="coverlet.collector" />
    </ItemGroup>
</Project>
