<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Environments</AssemblyName>
        <RootNamespace>Cratis.Environments</RootNamespace>
        <PackageId>Cratis.Environments</PackageId>
        <IsPackable>true</IsPackable>
        <!-- The repository default is a single TargetFramework; clear it so this published library multi-targets. -->
        <TargetFramework></TargetFramework>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <Authors>Cratis</Authors>
        <RepositoryUrl>https://github.com/Cratis/cli</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageDescription>Reads Cratis environments from .cratis/environments: configuration values and secrets resolved through passphrase, Azure Key Vault or HashiCorp Vault providers</PackageDescription>
        <PackageTags>cratis;environments;configuration;secrets;keyvault;vault</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://www.cratis.io/cli/</PackageProjectUrl>
        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="YamlDotNet" />
        <PackageReference Include="Azure.Identity" />
        <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="../../logo.png" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>
</Project>
