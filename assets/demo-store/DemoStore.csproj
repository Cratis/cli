<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone on purpose. This project is the fixture the README GIFs are recorded against,
    not part of the CLI solution, so it opts out of the repository's central package management
    and builds on its own.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bookshop</RootNamespace>
    <AssemblyName>Bookshop</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cratis.Chronicle" Version="16.7.0" />
  </ItemGroup>

</Project>
