<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes the canonical screen-composition corpus at the Screenplay version this CLI bundles, so the rendered-React
       integration check renders exactly the source the conformance matrix uses. Not part of Cli.slnx; the script builds it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cratis.Screenplay.CanonicalCorpus" />
  </ItemGroup>
</Project>
