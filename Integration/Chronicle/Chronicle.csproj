<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Cli.Integration.Chronicle</AssemblyName>
        <RootNamespace>Cratis.Cli.Integration.Chronicle</RootNamespace>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <CratisEmbeddedScreenplayEnabled>false</CratisEmbeddedScreenplayEnabled>
        <NoWarn>$(NoWarn);CRSPECEXP01</NoWarn>
        <LocalImageName>$(CRATIS_CHRONICLE_LOCAL_IMAGE)</LocalImageName>
        <LocalImageName Condition="'$(LocalImageName)' == ''">ghcr.io/cratis/chronicle:latest</LocalImageName>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../Source/Cli/Cli.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Snappier" />
        <PackageReference Include="Cratis.Chronicle.Connections" />
        <PackageReference Include="MongoDB.Driver" />
        <PackageReference Include="Testcontainers" />
        <PackageReference Include="xunit.v3.mtp-off" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
        <PackageReference Include="coverlet.collector" />
    </ItemGroup>
</Project>
