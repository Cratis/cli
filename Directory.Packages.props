<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CratisArcScreenplayVersion>23.15.1</CratisArcScreenplayVersion>
    <CratisCritterStackScreenplayVersion>0.29.3</CratisCritterStackScreenplayVersion>
    <CratisScreenplayGenerationVersion>0.24.0</CratisScreenplayGenerationVersion>
    <CratisPrologueVersion>3.2.1</CratisPrologueVersion>
    <ScreenplayVersion Condition="'$(ScreenplayVersion)' == ''">6.37.0</ScreenplayVersion>
    <!-- The Stage packages the renderer uses and the Stage container 'cratis run' starts are the same release. -->
    <StageVersion Condition="'$(StageVersion)' == ''">6.4.1</StageVersion>
    <CratisStageAxonVersion Condition="'$(CratisStageAxonVersion)' == ''">0.12.0</CratisStageAxonVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cratis -->
    <PackageVersion Include="Cratis.Arc.Screenplay" Version="$(CratisArcScreenplayVersion)" />
    <!-- 'cratis view' serves the event model explorer Arc ships, over documents generated in memory when the
         application was built without embedding them. Same release as Cratis.Arc.Screenplay. -->
    <PackageVersion Include="Cratis.Arc.Screenplay.Embedded" Version="$(CratisArcScreenplayVersion)" />
    <PackageVersion Include="Cratis.Arc.Screenplay.Embedded.Generation" Version="$(CratisArcScreenplayVersion)" />
    <PackageVersion Include="Cratis.CritterStack.Screenplay" Version="$(CratisCritterStackScreenplayVersion)" />
    <PackageVersion Include="Cratis.Screenplay.Generation.Contracts" Version="$(CratisScreenplayGenerationVersion)" />
    <PackageVersion Include="Cratis.Screenplay.Generation" Version="$(CratisScreenplayGenerationVersion)" />
    <PackageVersion Include="Cratis.Screenplay.Generation.DotNet" Version="$(CratisScreenplayGenerationVersion)" />
    <PackageVersion Include="Cratis.Screenplay.Generation.DotNet.Vogen" Version="$(CratisScreenplayGenerationVersion)" />
    <PackageVersion Include="Cratis.Chronicle.Connections" Version="19.183.4" />
    <PackageVersion Include="Cratis.Chronicle.Contracts" Version="19.183.4" />
    <PackageVersion Include="Cratis.Chronicle.XUnit.Integration.v3" Version="19.183.4" />
    <PackageVersion Include="Cratis.Fundamentals" Version="7.34.4" />
    <!-- Prologue -->
    <PackageVersion Include="Cratis.Prologue.Configuration" Version="$(CratisPrologueVersion)" />
    <PackageVersion Include="Cratis.Prologue.Contracts" Version="$(CratisPrologueVersion)" />
    <PackageVersion Include="Cratis.Prologue.Interpretation" Version="$(CratisPrologueVersion)" />
    <PackageVersion Include="Cratis.Prologue.Interpreter.Contracts" Version="$(CratisPrologueVersion)" />
    <PackageVersion Include="Cratis.Prologue.Screenplay" Version="$(CratisPrologueVersion)" />
    <!-- Keep Screenplay and its canonical corpus aligned; validate reverse-emitter compatibility when upgrading. -->
    <!-- Keep the published Screenplay, MCP, and canonical-corpus packages on the same release. -->
    <PackageVersion Include="Cratis.Screenplay" Version="$(ScreenplayVersion)" />
    <PackageVersion Include="Cratis.Screenplay.Mcp" Version="$(ScreenplayVersion)" />
    <PackageVersion Include="Cratis.Screenplay.CanonicalCorpus" Version="$(ScreenplayVersion)" />
    <PackageVersion Include="Cratis.Stage.Contracts" Version="$(StageVersion)" />
    <PackageVersion Include="Cratis.Stage.Rendering.Axon" Version="$(CratisStageAxonVersion)" />
    <PackageVersion Include="Cratis.Stage.Rendering.Cratis" Version="$(StageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <!-- CLI -->
    <PackageVersion Include="MongoDB.Driver" Version="3.14.1" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <!-- Native Codex configuration parsing and lossless token-span edits. -->
    <PackageVersion Include="Tomlyn" Version="2.11.1" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageVersion Include="SharpConsoleUI" Version="2.11.0" />
    <PackageVersion Include="AngleSharp" Version="1.10.5" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <!-- Source Generator -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <!-- Source reading — loading a solution or project into a Roslyn compilation for Screenplay generation. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <!-- Shipped with the CLI for the workspace API; Roslyn's out-of-process BuildHost selects the installed SDK that evaluates each project. -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.12.2" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.12.2" />
    <!-- Environments and secrets -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <!-- Analysis -->
    <!-- Newer StyleCop releases require unrelated conditional-expression formatting changes (SA1143). -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.342" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.12.0" />
    <!-- Transitive dependency overrides to address known vulnerabilities -->
    <PackageVersion Include="Snappier" Version="1.3.2" />
    <!-- Integration Testing -->
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <!-- Testing -->
    <PackageVersion Include="Cratis.Specifications.XUnit.v3" Version="5.3.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
  </ItemGroup>
</Project>